#cloud-config
hostname: ${hostname}
fqdn: ${hostname}.local
manage_etc_hosts: true

users:
  - name: ${admin_username}
    groups: [sudo]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${ssh_public_key}
    lock_passwd: true

package_update: true
package_upgrade: true
packages:
  - curl
  - sudo
  - qemu-guest-agent

# Belt and suspenders: the Packer template already ships with no swap
# and qemu-guest-agent enabled, this just guarantees it on every boot.
runcmd:
  - swapoff -a
  - sed -i '/\sswap\s/d' /etc/fstab
  - systemctl enable --now qemu-guest-agent

  # --- k3s ---
  # Matches your manual install: helm-controller disabled, config left
  # at /etc/rancher/k3s/k3s.yaml.
  - curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="--disable=helm-controller" sh -
  - systemctl enable --now k3s

  # Wait for k3s to actually be ready before we try to bootstrap Flux
  # against it (first boot on modest homelab hardware can take a minute).
  - |
    for i in $(seq 1 60); do
      /usr/local/bin/kubectl --kubeconfig /etc/rancher/k3s/k3s.yaml get nodes >/dev/null 2>&1 && break
      sleep 5
    done

  # Kubeconfig readable by the admin user, same as your manual "cp to non-root, chown" step.
  - mkdir -p /home/${admin_username}/.kube
  - cp /etc/rancher/k3s/k3s.yaml /home/${admin_username}/.kube/config
  - chown -R ${admin_username}:${admin_username} /home/${admin_username}/.kube
  - chmod 600 /home/${admin_username}/.kube/config

  # --- Flux CLI + bootstrap ---
  - curl -s https://fluxcd.io/install.sh | bash
  - ln -sf /root/.local/bin/flux /usr/local/bin/flux

  - |
    export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
    export GITHUB_TOKEN="${github_token}"
    export GITHUB_USER="${github_user}"
    /usr/local/bin/flux bootstrap github \
      --owner="$GITHUB_USER" \
      --repository=${github_repo} \
      --branch=${github_branch} \
      --path=${flux_path} \
      --personal \
      >> /var/log/flux-bootstrap.log 2>&1

  # Don't leave the token sitting in shell history / env after the fact.
  - unset GITHUB_TOKEN

final_message: "${hostname} ready: k3s up, Flux bootstrap attempted (see /var/log/flux-bootstrap.log). Boot took $UPTIME seconds."
